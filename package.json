{
  "name": "@cotizave/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Cotizave API v2 — multi-country exchange-rate references, conversions, history, banks and calendars.",
  "license": "MIT",
  "author": "Cotizave",
  "homepage": "https://github.com/cotizave/cotizave-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cotizave/cotizave-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/cotizave/cotizave-typescript/issues"
  },
  "keywords": [
    "cotizave",
    "exchange-rate-api",
    "currency-api",
    "forex-api",
    "typescript",
    "sdk",
    "exchange-rates",
    "currency-conversion"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tsconfig.typetest.json",
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.4.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.21.5": true
  }
}
