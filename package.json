{
  "name": "@cotizave/sdk",
  "version": "0.1.1",
  "description": "Official TypeScript SDK for the Cotizave API v2 — multi-country exchange-rate references, conversions, history, banks and calendars.",
  "license": "MIT",
  "author": "Cotizave",
  "homepage": "https://github.com/cotizave/cotizave-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cotizave/cotizave-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/cotizave/cotizave-typescript/issues"
  },
  "keywords": [
    "cotizave",
    "exchange-rate-api",
    "currency-api",
    "forex-api",
    "typescript",
    "sdk",
    "exchange-rates",
    "currency-conversion"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "publint && attw --pack .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:types": "tsc --noEmit -p tsconfig.typetest.json",
    "version": "node scripts/sync-version.mjs && git add src/config.ts",
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.17.0",
    "ky": "^2.2.0",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "tsup": {
      "esbuild": "^0.28.1"
    }
  }
}
